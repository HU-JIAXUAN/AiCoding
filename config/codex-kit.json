      "webapp-testing": "standalone/webapp-testing",
      "wizard": "external/mattpocock-skills/skills/engineering/wizard",
      "writing-for-agents": "external/mattpocock-skills/skills/productivity/writing-for-agents"
    },
    "skills": [
      "ask-matt",
