      "codebase-design",
      "diagnosing-bugs",
      "domain-modeling",
      "drawio-skill",
      "grill-me",
      "grill-with-docs",
      "grilling",
      "handoff",
      "implement",
      "improve-codebase-architecture",
      "json-canvas",
      "mcp-builder",
      "obsidian-bases",
