{
  "name": "AiCoding",
  "version": "0.1.0",
  "codingKitRoot": "./CodingKit",
  "agents": {
    "skillsSubmodule": "./CodingKit/agents/skills",
    "pluginPath": "./CodingKit/agents/skills/plugins/AiCoding",
    "marketplacePath": "./.agents/plugins/marketplace.json"
  },
  "assets": {
    "examples": "./CodingKit/examples",
    "modules": "./CodingKit/modules",
    "platforms": "./CodingKit/platforms",
    "tests": "./CodingKit/tests",
    "tools": "./CodingKit/tools"
  },
  "rules": {
    "buildPluginInSubmodule": false,
    "pluginInstallUsesMarketplace": true,
    "hooksAreAuxiliaryConstraints": true
  },
  "skillRuntime": {
    "canonicalUserRoot": "%USERPROFILE%\\.agents\\skills",
    "codexUserRoot": "%USERPROFILE%\\.codex\\skills",
    "sourceRepositoryEnv": "AICODING_SKILL_SOURCE_REPO",
    "defaultSourceRepository": "../Codex-Skills",
    "sourceRepositoryMustNotBeUnderSkillRoot": true,
    "rejectDuplicateNames": true,
    "rejectGeneratedSkillLinks": true,
    "rejectWholeRepositoryLinks": true
  },
  "profiles": {
    "runtime": {
      "pluginEnabled": true,
      "sourceSkillLinks": [],
      "standaloneSkills": []
    },
    "skill-development": {
      "pluginEnabled": false,
      "allowSelectedSourceSkillLinks": true,
      "maxSelectedSourceSkills": 1
    },
    "full": {
      "pluginEnabled": true,
      "sourceSkillLinks": [],
      "standaloneSkills": [
        "ask-matt",
        "code-review",
        "codebase-design",
        "diagnosing-bugs",
        "domain-modeling",
        "drawio-skill",
        "grill-me",
        "grill-with-docs",
        "grilling",
        "handoff",
        "implement",
        "improve-codebase-architecture",
        "json-canvas",
        "mcp-builder",
        "obsidian-bases",
        "obsidian-cli",
        "obsidian-markdown",
        "prototype",
        "research",
        "resolving-merge-conflicts",
        "setup-matt-pocock-skills",
        "tdd",
        "teach",
        "to-questionnaire",
        "to-spec",
        "to-tickets",
        "triage",
        "visio-diagram",
        "wait-what",
        "wayfinder",
        "webapp-testing",
        "wizard",
        "writing-for-agents"
      ]
    }
  },
  "standaloneSkillRegistry": {
    "sourceRepositoryEnv": "AICODING_SKILL_SOURCE_REPO",
    "sourceRepository": "../Codex-Skills",
    "defaultSourceRepository": "../Codex-Skills",
    "defaultInstallRoot": "%USERPROFILE%\\.agents\\skills",
    "supportedInstallRoots": [
      "agents",
      "codex"
    ],
    "linkMode": "junction",
    "installByProfile": true,
    "sourcePaths": {
      "ask-matt": "external/mattpocock-skills/skills/engineering/ask-matt",
      "code-review": "external/mattpocock-skills/skills/engineering/code-review",
      "codebase-design": "external/mattpocock-skills/skills/engineering/codebase-design",
      "diagnosing-bugs": "external/mattpocock-skills/skills/engineering/diagnosing-bugs",
      "domain-modeling": "external/mattpocock-skills/skills/engineering/domain-modeling",
      "drawio-skill": "external/drawio-skill/skills/drawio-skill",
      "grill-me": "external/mattpocock-skills/skills/productivity/grill-me",
      "grill-with-docs": "external/mattpocock-skills/skills/engineering/grill-with-docs",
      "grilling": "external/mattpocock-skills/skills/productivity/grilling",
      "handoff": "external/mattpocock-skills/skills/productivity/handoff",
      "implement": "external/mattpocock-skills/skills/engineering/implement",
      "improve-codebase-architecture": "external/mattpocock-skills/skills/engineering/improve-codebase-architecture",
      "json-canvas": "standalone/json-canvas",
      "mcp-builder": "standalone/mcp-builder",
      "obsidian-bases": "standalone/obsidian-bases",
      "obsidian-cli": "standalone/obsidian-cli",
      "obsidian-markdown": "standalone/obsidian-markdown",
      "prototype": "external/mattpocock-skills/skills/engineering/prototype",
      "research": "external/mattpocock-skills/skills/engineering/research",
      "resolving-merge-conflicts": "external/mattpocock-skills/skills/engineering/resolving-merge-conflicts",
      "setup-matt-pocock-skills": "external/mattpocock-skills/skills/engineering/setup-matt-pocock-skills",
      "tdd": "external/mattpocock-skills/skills/engineering/tdd",
      "teach": "external/mattpocock-skills/skills/productivity/teach",
      "to-questionnaire": "external/mattpocock-skills/skills/productivity/to-questionnaire",
      "to-spec": "external/mattpocock-skills/skills/engineering/to-spec",
      "to-tickets": "external/mattpocock-skills/skills/engineering/to-tickets",
      "triage": "external/mattpocock-skills/skills/engineering/triage",
      "visio-diagram": "standalone/visio-diagram",
