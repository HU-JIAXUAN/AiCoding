      "obsidian-markdown",
      "prototype",
      "research",
      "resolving-merge-conflicts",
      "setup-matt-pocock-skills",
      "tdd",
      "teach",
      "to-questionnaire",
      "to-spec",
      "to-tickets",
      "triage",
      "visio-diagram",
      "wait-what",
      "wayfinder",
      "webapp-testing",
      "wizard",
      "writing-for-agents"
    ]
  }
