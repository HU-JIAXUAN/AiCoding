{
  "schemaVersion": 1,
  "description": "项目自研 C99 的普通中文注释模板；只填写可核实的使用说明，项目明确要求时另用 Doxygen。",
  "templates": [
    {
      "id": "c-file-header-professional",
      "title": "C 文件职责与使用条件",
      "description": "C 文件职责与使用条件",
      "language": "c",
      "kind": "file-header",
      "body": [
        "/*",
        "    用途：{{brief}}",
        "    职责边界：{{boundary}}",
        "    使用条件：{{constraints}}",
        "*/"
      ],
      "variables": {
        "brief": {
          "description": "实际用途；说明输入来自哪里、输出供谁使用。",
          "default": "",
          "required": true
        },
        "boundary": {
          "description": "本文件负责的能力及不负责的硬件或业务动作。",
          "default": "",
          "required": true
        },
        "constraints": {
          "description": "实际初始化条件、调用上下文、阻塞或资源寿命。",
          "default": "",
          "required": true
        }
      }
    },
    {
      "id": "c-file-header-cn",
      "title": "简短中文 C 文件说明",
      "description": "简短中文 C 文件说明",
      "language": "c",
      "kind": "file-header",
      "body": [
        "/*",
        "    用途：{{brief}}",
        "    职责边界：{{boundary}}",
        "    使用条件：{{constraints}}",
        "*/"
      ],
      "variables": {
        "brief": {
          "description": "实际用途；说明输入来自哪里、输出供谁使用。",
          "default": "",
          "required": true
        },
        "boundary": {
          "description": "本文件负责的能力及不负责的硬件或业务动作。",
          "default": "",
          "required": true
        },
        "constraints": {
          "description": "实际初始化条件、调用上下文、阻塞或资源寿命。",
          "default": "",
          "required": true
        }
      }
    },
    {
      "id": "c-function-header-full",
      "title": "函数调用说明",
      "description": "函数调用说明",
      "language": "c",
      "kind": "function-header",
      "body": [
        "/*",
        "    {{brief}}",
        "    输入：{{inputs}}",
        "    输出：{{outputs}}",
        "    返回：{{result}}",
        "    约束：{{constraints}}",
        "*/"
      ],
      "variables": {
        "brief": {
          "description": "填写实际用途，不复制函数名或虚构功能。",
          "default": "",
          "required": true
        },
        "inputs": {
          "description": "逐项写参数名、用途、单位、范围、可空性和有效存储寿命。",
          "default": "",
          "required": true
        },
        "outputs": {
          "description": "逐项写输出参数；仅成功时有效、失败不修改。既定契约不同则如实说明，不适用的整行删除。",
          "default": "",
          "required": true
        },
        "result": {
          "description": "真实成功/失败返回含义；void函数删除该行，不造空标签。",
          "default": "",
          "required": true
        },
        "constraints": {
          "description": "实际任务/ISR上下文、阻塞性、重入与资源寿命；关键顺序和原因留在相邻实现说明。",
          "default": "",
          "required": true
        }
      }
    },
    {
      "id": "c-function-header-void",
      "title": "简短函数说明",
      "description": "简短函数说明",
      "language": "c",
      "kind": "function-header",
      "body": [
        "/* {{brief}} */"
      ],
      "variables": {
        "brief": {
          "description": "填写实际用途，不复制函数名或虚构功能。",
          "default": "",
          "required": true
        }
      }
    },
    {
      "id": "c-section-divider",
      "title": "中文代码分区",
      "description": "中文代码分区",
      "language": "c",
      "kind": "section",
      "body": [
        "/************************ {{sectionName}} ************************/"
      ],
      "variables": {
        "sectionName": {
          "description": "有助于阅读的职责分区名称。",
          "default": "模块内部函数",
          "required": true
        }
      }
    },
    {
      "id": "c-struct-brief",
      "title": "结构体用途与字段说明",
      "description": "结构体用途与字段说明",
      "language": "c",
      "kind": "struct",
      "body": [
        "/* {{brief}} */",
        "typedef struct {",
        "    {{members}}",
        "} {{typeName}};"
      ],
      "variables": {
        "brief": {
          "description": "填写实际用途，不复制函数名或虚构功能。",
          "default": "",
          "required": true
        },
        "members": {
          "description": "实际字段；说明用途、单位或读写方。",
          "default": "uint32_t sampleCount; /* 已完成的采样次数 */",
          "required": true
        },
        "typeName": {
          "description": "项目类型名，默认 PascalCase。",
          "default": "SampleCount",
          "required": true
        }
      }
    },
    {
      "id": "c-enum-brief",
      "title": "枚举及逐值说明",
      "description": "枚举及逐值说明",
      "language": "c",
      "kind": "enum",
      "body": [
        "/* {{brief}} */",
        "typedef enum {",
        "    {{items}}",
        "} {{typeName}};"
      ],
      "variables": {
        "brief": {
          "description": "填写实际用途，不复制函数名或虚构功能。",
          "default": "",
          "required": true
        },
        "items": {
          "description": "实际枚举项及逐项中文说明。",
          "default": "MODULE_STOPPED = 0, /* 已停止 */",
          "required": true
        },
        "typeName": {
          "description": "项目类型名，默认 PascalCase。",
          "default": "ModuleState",
          "required": true
        }
      }
    },
    {
      "id": "c-common-includes",
      "title": "按使用需要选择标准头文件",
      "description": "按使用需要选择标准头文件",
      "language": "c",
      "kind": "includes",
      "body": [
        "#include <stdint.h>",
        "#include <stdbool.h>",
        "#include <stddef.h>"
      ],
      "variables": {}
    }
  ]
}
