{
  "C File Header (Professional)": {
    "prefix": "cfile",
    "body": [
      "/*",
      "    ${TM_FILENAME}",
      "    ${1:说明这个文件做什么及使用时需要注意什么}",
      "    作者 ${2:HU JIAXUAN}",
      "    日期 ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "*/",
      "",
      "$0"
    ],
    "description": "生成简明中文文件说明"
  },
  "C File Header (CN)": {
    "prefix": "文件说明",
    "body": [
      "/*",
      "    ${TM_FILENAME}",
      "    ${1:说明这个文件做什么及使用时需要注意什么}",
      "    作者 ${2:HU JIAXUAN}",
      "    日期 ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "*/",
      "",
      "$0"
    ],
    "description": "生成简明中文文件说明"
  },
  "C Function Header (Full)": {
    "prefix": "函数",
    "body": [
      "/*",
      "    ${1:说明函数做什么}",
      "    ${2:param_in} ${3:输入的用途、单位和范围}",
      "    ${4:param_out} ${5:输出的用途及何时有效}",
      "    返回 ${6:正常结果和错误处理}",
      "*/",
      "$0"
    ],
    "description": "按需说明函数、输入输出、单位和返回结果"
  },
  "C Function Header (Void)": {
    "prefix": "void函数",
    "body": [
      "/*",
      "    ${1:说明函数做什么}",
      "    ${2:param} ${3:参数用途、单位和范围}",
      "*/",
      "$0"
    ],
    "description": "按需说明无返回值函数的用途和参数"
  },
  "C Section Divider": {
    "prefix": "代码块",
    "body": [
      "/* ========================================================================== */",
      "/* ${1:SECTION NAME}                                                          */",
      "/* ========================================================================== */",
      "",
      "$0"
    ],
    "description": "生成代码分区标记，可保留分隔横幅"
  },
  "C Simple Object Macro": {
    "prefix": "简单宏",
    "body": [
      "#define ${2:MACRO_NAME} ${3:value}  /* ${1:说明用途、单位或范围} */",
      "",
      "$0"
    ],
    "description": "生成普通同行注释的对象式宏"
  },
  "C Struct Brief": {
    "prefix": "结构体",
    "body": [
      "/* ${1:说明这个结构体保存什么、由谁填写} */",
      "typedef struct",
      "{",
      "    ${2:uint32_t value;}  /* ${3:用途、单位和范围，需要时给出填写例子} */",
      "} ${4:type_name_t};",
      "",
      "$0"
    ],
    "description": "生成带用途和字段说明的结构体"
  },
  "C Enum Brief": {
    "prefix": "枚举",
    "body": [
      "/* ${1:说明这组状态或命令的用途} */",
      "typedef enum",
      "{",
      "    ${2:ENUM_ITEM_0} = 0,  /* ${3:第一个值表示什么} */",
      "    ${4:ENUM_ITEM_1},      /* ${5:第二个值表示什么} */",
      "    ${6:ENUM_ITEM_2}       /* ${7:第三个值表示什么} */",
      "} ${8:enum_name_t};",
      "",
      "$0"
    ],
    "description": "生成普通注释的枚举类型及各取值说明"
  },
  "C Common Includes": {
    "prefix": "常用头文件",
    "body": [
      "#include <stdint.h>",
      "#include <stdbool.h>",
      "#include <stddef.h>",
      "",
      "$0"
    ],
    "description": "引入嵌入式常用标准头文件"
  }
}
