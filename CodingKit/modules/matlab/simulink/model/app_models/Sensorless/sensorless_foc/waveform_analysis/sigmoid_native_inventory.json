  "root_read": "status: ok\nmodel: SigmoidSensorlessFOC\nscope: root\ntoken_estimate: 1418\nblocks: \n  algorithm: \n    - id: blk_10\n      Name: Controller\n      BlockType: SubSystem\n      derived_info: \n        expression: \"[voltage_request, theta_used, drive_enable] = Controller(current_ab, theta_hat, omega_hat, observer_valid, residual_norm, speed_reference, enable, reset, direction, voltage_residual, bus_voltage, voltage_demand) where current_ab=blk_4.current_ab, theta_hat=blk_424.theta_hat, omega_hat=blk_424.omega_hat, observer_valid=blk_424.valid, residual_norm=blk_424.residual_norm, speed_reference=blk_382.y1, enable=blk_383.permit, reset=blk_382.y4, direction=blk_382.y5, voltage_residual=blk_282.voltage_residual, bus_voltage=blk_382.y7, voltage_demand=blk_282.request_magnitude\"\n    - id: blk_370\n      Name: FeasibleVoltage\n      BlockType: Terminator\n      derived_info: \n        expression: Terminator(u1) where u1=blk_282.feasible_command\n    - id: blk_4\n      Name: Measurement\n      BlockType: SubSystem\n      derived_info: \n        expression: \"[current_ab, sampled_abc] = Measurement(phase_current) where phase_current=blk_279.phase_current\"\n    - id: blk_424\n      Name: Observer\n      BlockType: SubSystem\n      derived_info: \n        expression: \"[theta_hat, omega_hat, valid, residual_norm, start_voltage_magnitude] = Observer(phase_voltage, current_ab, enable, reset, direction) where phase_voltage=blk_279.phase_voltage, current_ab=blk_4.current_ab, enable=blk_221.y1, reset=blk_382.y4, direction=blk_382.y5\"\n    - id: blk_220\n      Name: ObserverEnabled\n      BlockType: Logic\n      derived_info: \n        expression: \"y1 = Logic(u1, u2) where u1=blk_382.y3, u2=blk_382.y6\"\n    - id: blk_221\n      Name: ObserverEnabledDouble\n      BlockType: DataTypeConversion\n      derived_info: \n        expression: y1 = DataTypeConversion(u1) where u1=blk_220.y1\n    - id: blk_279\n      Name: Plant\n      BlockType: SubSystem\n      derived_info: \n        expression: \"[phase_current, theta_e, phase_voltage] = Plant(duty, mode, load_torque, bus_voltage) where duty=blk_282.duty_applied, mode=blk_10.drive_enable, load_torque=blk_382.y2, bus_voltage=blk_382.y7\"\n    - id: blk_372\n      Name: SaveTrace\n      BlockType: ToWorkspace\n      derived_info: \n        expression: ToWorkspace(u1) where u1=blk_371.y1\n    - id: blk_383\n      Name: StartInterlock\n      BlockType: SubSystem\n      derived_info: \n        expression: \"permit = StartInterlock(request_enable, reset, observer_enable, voltage_magnitude, direction) where request_enable=blk_382.y3, reset=blk_382.y4, observer_enable=blk_221.y1, voltage_magnitude=blk_424.start_voltage_magnitude, direction=blk_382.y5\"\n    - id: blk_371\n      Name: TraceChannels\n      BlockType: Mux\n      derived_info: \n        expression: \"y1 = [u1, u2, u3, u4, u5, u6, u7, u8, u9, u10] where u1=blk_216.y1, u2=blk_10.voltage_request, u3=blk_10.theta_used, u4=blk_282.phase_voltage, u5=blk_282.duty_command, u6=blk_282.duty_applied, u7=blk_282.limit_scale, u8=blk_282.voltage_residual, u9=blk_4.sampled_abc, u10=blk_4.current_ab\"\n    - id: blk_369\n      Name: UnneededTruthAngle\n      BlockType: Terminator\n      derived_info: \n        expression: Terminator(u1) where u1=blk_279.theta_e\n    - id: blk_282\n      Name: VoltageStage\n      BlockType: SubSystem\n      derived_info: \n        expression: \"[duty_command, duty_applied, limit_scale, voltage_residual, feasible_command, phase_voltage, request_magnitude] = VoltageStage(voltage_request, theta_feedback, bus_voltage, actual_phase_voltage, drive_enable) where voltage_request=blk_10.voltage_request, theta_feedback=blk_10.theta_used, bus_voltage=blk_382.y7, actual_phase_voltage=blk_279.phase_voltage, drive_enable=blk_10.drive_enable\"\n    - id: blk_382\n      Name: inputs\n      BlockType: Demux\n      derived_info: \n        expression: \"[y1, y2, y3, y4, y5, y6, y7] = u1 where u1=blk_216.y1\"\n    - id: blk_216\n      Name: stimulus\n      BlockType: FromWorkspace\n      derived_info: \n        expression: y1 = FromWorkspace()\nconnections: \n  - id: \"blk_216.y1 -> blk_382.u1,blk_371.u1\"\n  - id: \"blk_282.y5 -> blk_370.u1\"\n  - id: \"blk_282.y6 -> blk_371.u4\"\n  - id: \"blk_282.y1 -> blk_371.u5\"\n  - id: \"blk_282.y3 -> blk_371.u7\"\n  - id: \"blk_382.y6 -> blk_220.u2\"\n  - id: \"blk_371.y1 -> blk_372.u1\"\n  - id: \"blk_424.residual_norm -> blk_10.residual_norm\"\n  - id: \"blk_424.valid -> blk_10.observer_valid\"\n  - id: \"blk_424.omega_hat -> blk_10.omega_hat\"\n  - id: \"blk_424.theta_hat -> blk_10.theta_hat\"\n  - id: \"blk_424.start_voltage_magnitude -> blk_383.voltage_magnitude\"\n  - id: \"blk_4.sampled_abc -> blk_371.u9\"\n  - id: \"blk_382.y2 -> blk_279.load_torque\"\n  - id: \"blk_279.theta_e -> blk_369.u1\"\n  - id: \"blk_279.phase_current -> blk_4.phase_current\"\n  - id: \"blk_282.y2 -> blk_371.u6,blk_279.duty\"\n  - id: \"blk_383.permit -> blk_10.enable\"\n  - id: \"blk_221.y1 -> blk_424.enable,blk_383.observer_enable\"\n  - id: \"blk_4.current_ab -> blk_424.current_ab,blk_10.current_ab,blk_371.u10\"\n  - id: \"blk_10.voltage_request -> blk_282.u1,blk_371.u2\"\n  - id: \"blk_10.theta_used -> blk_282.u2,blk_371.u3\"\n  - id: \"blk_279.phase_voltage -> blk_424.phase_voltage,blk_282.u4\"\n  - id: \"blk_10.drive_enable -> blk_282.u5,blk_279.mode\"\n  - id: \"blk_282.y4 -> blk_10.voltage_residual,blk_371.u8\"\n  - id: \"blk_282.y7 -> blk_10.voltage_demand\"\n  - id: \"blk_220.y1 -> blk_221.u1\"\n  - id: \"blk_382.y1 -> blk_10.speed_reference\"\n  - id: \"blk_382.y3 -> blk_383.request_enable,blk_220.u1\"\n  - id: \"blk_382.y4 -> blk_424.reset,blk_383.reset,blk_10.reset\"\n  - id: \"blk_382.y5 -> blk_424.direction,blk_383.direction,blk_10.direction\"\n  - id: \"blk_382.y7 -> blk_282.u3,blk_279.bus_voltage,blk_10.bus_voltage\"\n\nblock_type_descriptions: \n  SubSystem: Group blocks into subsystem for model hierarchy\n  Terminator: Terminate unconnected output port\n  Logic: \"Perform logical operation (AND, OR, NAND, NOR, XOR, NXOR, NOT)\"\n  DataTypeConversion: Convert input signal to specified data type\n  ToWorkspace: Write data to workspace variable\n  FromWorkspace: Output data from MATLAB workspace variable",
